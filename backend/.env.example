# ===================================
# BACKEND ENVIRONMENT VARIABLES
# ===================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/little-angels?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_EXPIRE=7d

# Cloudinary File Upload Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Additional CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://littleangelsschool.com

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# School Configuration
SCHOOL_NAME=Little Angels School
SCHOOL_TIMEZONE=UTC

# Logging
LOG_LEVEL=info

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration (Optional)
SESSION_SECRET=your-session-secret-key

# File Upload Limits
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads/

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Database Backup (Optional)
BACKUP_ENABLED=false
BACKUP_INTERVAL=daily

# Error Reporting (Optional - Sentry)
SENTRY_DSN=

# Feature Flags (Optional)
FEATURE_PDF_REPORTS=true
FEATURE_ANNOUNCEMENTS=true
FEATURE_ASSIGNMENTS=true
FEATURE_AUDIT_LOGS=true
