# ===================================
# FRONTEND ENVIRONMENT VARIABLES
# ===================================

# API Configuration
VITE_API_BASE_URL=http://localhost:5000
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=Little Angels School Management
VITE_APP_DESCRIPTION=School Management System for Little Angels School

# Public URLs
VITE_PUBLIC_URL=/
VITE_HOME_URL=http://localhost:5173

# Feature Flags
VITE_FEATURE_PDF_REPORTS=true
VITE_FEATURE_ANNOUNCEMENTS=true
VITE_FEATURE_ASSIGNMENTS=true
VITE_FEATURE_AUDIT_LOGS=true

# Analytics (Optional - Google Analytics)
VITE_GOOGLE_ANALYTICS_ID=

# Sentry Error Tracking (Optional)
VITE_SENTRY_DSN=

# App Environment
VITE_ENVIRONMENT=development

# Debug Mode
VITE_DEBUG_MODE=false

# School Branding Colors (CSS Variables)
VITE_PRIMARY_COLOR=#003366
VITE_SECONDARY_COLOR=#FFD700
VITE_SUCCESS_COLOR=#28a745
VITE_DANGER_COLOR=#dc3545
VITE_WARNING_COLOR=#ffc107
VITE_INFO_COLOR=#17a2b8

# Pagination
VITE_ITEMS_PER_PAGE=10

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ACCEPTED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png,.xls,.xlsx

# Production URLs (Update for your domain)
# VITE_API_BASE_URL=https://api.littleangelsschool.com
# VITE_HOME_URL=https://littleangelsschool.com
